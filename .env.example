# PyPLUS configuration — copy to .env and fill in your values.
# NEVER commit .env to version control.

# ── Encryption key (required for remember-me and background jobs) ─────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If absent, remember-me is disabled (fail safe — not bypassed).
PYPLUS_SECRET_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
# Bind address served behind your reverse proxy
PYPLUS_HOST=127.0.0.1
PYPLUS_PORT=8080

# ── Data directory ────────────────────────────────────────────────────────────
# Where the SQLite database, ML artifacts, and logs are stored.
# Default: ~/.local/share/pyplus
PYPLUS_DATA_DIR=

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Set to 1 to disable the in-app APScheduler and manage all jobs via crontab.
PYPLUS_DISABLE_SCHEDULER=0

# ── ntfy (push notifications) ─────────────────────────────────────────────────
# Default ntfy instance — can be overridden per user in Settings.
# PYPLUS_NTFY_URL=https://ntfy.sh

# ── Deep links (optional) ─────────────────────────────────────────────────────
# Public URL of the app, included in ntfy alert messages as a tap-to-open link.
# Leave empty to omit deep links from messages.
# PYPLUS_BASE_URL=http://localhost:8080
